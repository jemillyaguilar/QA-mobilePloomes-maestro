# ---------------------------------------------------------------------------
# Build 9.12.0 (265)
# ---------------------------------------------------------------------------
# Terceira build, diferente da 262 e da 263 citadas na pagina de CTs.
# A CONFIRMAR: se contem o form de CPQ com IA e se tem ou nao o Tirador.
#
#   package .......... com.ploomes.mobileapp.dev
#   versionName ...... 9.12.0
#   versionCode ...... 265
#   activity ......... com.ploomes.mobileapp.MainActivity
#   emulador ......... Pixel_7, API 35, x86_64, page size 16 KB
#   idioma ........... pt-BR por app (cmd locale set-app-locales), nao do sistema:
#                      a imagem Google Play nao aceita adb root.
#
# Ver docs/SELETORES.md para o que cada variavel significa.

BUILD=265
APP_ID=com.ploomes.mobileapp.dev

# --- credenciais ---------------------------------------------------------
# Ficam em config/credenciais.local (fora do git). Ver config/credenciais.local.example.

# --- massa de teste ------------------------------------------------------
ENTIDADE=Proposta
MODELO_COM_IA=<<Modelo QA - com form IA>>
MODELO_SEM_IA=<<Modelo QA - sem form IA>>

# --- seletores: login (conferidos na 265 em 23/09/2026) ------------------
SEL_LOGIN_EMAIL=login-email
SEL_LOGIN_SENHA=login-password
# O testID login-submit se repete em "Entrar" e "Entrar com UK".
# Usar sempre id + texto (ver subflows/login.yaml).
SEL_LOGIN_BOTAO_ID=login-submit
SEL_LOGIN_BOTAO=Entrar

# --- modal "Novidades" ----------------------------------------------------
# Aparece após o login (a cada clearState), 3 slides. Tratado em
# subflows/fechar_novidades.yaml. O X usa header-right-button, ID genérico
# que também é o botão de IA da home: por isso fecha pelos textos.

# --- seletores: navegação (conferidos na 265 em 23/09/2026) -------------
SEL_FAB_NOVO=fab
SEL_TAB_INICIO=tab-bar-button-home
SEL_TAB_NEGOCIOS=tab-bar-button-deals
SEL_TAB_DOCUMENTOS=tab-bar-button-documents
SEL_TAB_PRODUTOS=tab-bar-button-products
SEL_TAB_MAIS=tab-bar-button-more
TXT_BANNER_SEM_CONEXAO=Problemas de conexão
TXT_MENU_ENTIDADE=Propostas

# --- seletores: web view / formulários -----------------------------------
SEL_WEBVIEW_CPQ=<<id-do-container-webview>>
TXT_TITULO_FORM_IA=<<titulo-visivel-do-form-IA>>
TXT_TITULO_TIRADOR=<<titulo-do-tirador-de-pedidos>>
TXT_TITULO_FORM_PADRAO=<<titulo-do-form-padrao>>
SEL_BTN_SALVAR=Salvar

# --- seletores: campos do formulário ------------------------------------
SEL_CAMPO_OBRIGATORIO=<<id-campo-obrigatorio>>
SEL_CAMPO_TEXTO=<<id-campo-texto>>
SEL_CAMPO_EFEMERO=<<id-campo-calculo-efemero>>
VALOR_CAMPO_TEXTO=QA HC-29
VALOR_CAMPO_EFEMERO=123

# --- seletores: produtos -------------------------------------------------
SEL_BUSCA_PRODUTO=<<id-busca-produto>>
NOME_PRODUTO=<<Produto QA>>
SEL_CAMPO_QTD=<<id-quantidade>>
SEL_CAMPO_DESCONTO=<<id-desconto>>
SEL_TOTAL=<<id-total>>

# --- seletores: botões flutuantes nativos --------------------------------
SEL_BTN_CHECKIN=<<id-checkin>>
SEL_BTN_GRAVACAO=<<id-gravacao>>

# --- textos de erro / confirmação ---------------------------------------
TXT_MSG_ERRO_WEBVIEW=<<mensagem-de-erro-de-carregamento>>
TXT_CONFIRMA_DESCARTE=<<texto-do-dialogo-de-descarte>>
TXT_MSG_OBRIGATORIO=<<mensagem-de-campo-obrigatorio>>
TXT_MSG_SEM_PERMISSAO=<<mensagem-de-sem-permissao>>
